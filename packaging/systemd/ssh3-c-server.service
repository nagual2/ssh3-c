[Unit]
Description=SSH3 server (sessions and forwards over HTTP/3, RFC 9220)
Documentation=man:ssh3-server(8)
# The socket unit owns UDP/443: systemd binds it as root and hands the
# ready fd to the service (the sd_listen_fds(3) protocol, the daemon
# logs "socket-activated").  The service therefore never binds and
# needs NO CAP_NET_BIND_SERVICE - the port privilege stays inside the
# root-owned socket unit while the service itself keeps only what the
# per-session setuid transition needs (the bounding set below).
Requires=ssh3-c-server.socket
After=network.target

[Service]
# exec: the failure of the binary itself (bad key paths, the
# socket-activation guard) must fail the unit, not hang "simple"
Type=exec
# no -l: under LISTEN_FDS the daemon serves the passed fd and binds
# nothing; the flags, the env table and the drop-in recipes live in
# ssh3-server(8)
ExecStart=/usr/sbin/ssh3-server -c /etc/ssh3/cert.pem -k /etc/ssh3/priv.key
Environment=SSH3_LOG_LEVEL=info
#
# PRIVILEGE MODELS (P7.3) - pick exactly one:
#
# 1. SHIPPED, root daemon + per-session setuid (the OpenSSH/Go
#    shape): the service runs as root, after the CONNECT
#    authentication every session with a resolvable username drops
#    onto it (initgroups, setgid, setuid, the home chdir) before any
#    spawn; a user without a passwd entry answers 401 at the CONNECT.
#    The socket activation keeps the passwordless 443, the bounding
#    set keeps the root year minimal.  The hardening that conflicts
#    with the identity switch is OFF and marked below: a root
#    process must be allowed to setuid()/setgroups(), so
#    NoNewPrivileges and RestrictSUIDSGID stay disabled, and the
#    session children touch the real /home (ProtectHome=no).
#
# 2. SINGLE-IDENTITY, unprivileged daemon (the P7.2 shape): keep the
#    three lines below commented out and add from a drop-in:
#      systemctl edit ssh3-c-server.service
#      [Service]
#      User=ssh3
#      Group=ssh3
#      NoNewPrivileges=yes
#      RestrictSUIDSGID=yes
#      CapabilityBoundingSet=
#      ExecStart=
#      ExecStart=/usr/sbin/ssh3-server --run-as-user off -c /etc/ssh3/cert.pem -k /etc/ssh3/priv.key
#    ...and restore ProtectHome=yes below.  Every session (and the
#    in-process sftp) then runs as the ssh3 account; per-user
#    identities and /home access are not available in this model.
#
User=root
Group=root
NoNewPrivileges=no

# the writable state (sftp jail via the -H override, session
# artifacts) lives here, not under /home
StateDirectory=ssh3
RuntimeDirectory=ssh3
# the daemon drains the active conversations on SIGTERM (default 5s,
# SSH3_SHUTDOWN_DRAIN), 30s leaves it one drain plus the close grace
TimeoutStopSec=30s
Restart=on-failure
RestartSec=3s
UMask=0077

# Hardening.  The daemon is a plain C17 binary (no JIT, no runtime
# code loading): MemoryDenyWriteExecute is safe.  ProtectSystem=strict
# keeps /usr,/boot,/etc read-only under both privilege models.
ProtectSystem=strict
# model 1: the session children chdir into and work inside the real
# user homes; model 2 restores ProtectHome=yes
ProtectHome=no
PrivateTmp=yes
# the pty sessions need the real /dev: the private device set of
# PrivateDevices=yes ships /dev/ptmx but not the /dev/pts mount, the
# child reopen of the slave answers ENOENT (the session exits 127)
PrivateDevices=no
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictRealtime=yes
# model 1: setuid()/setgroups() of the session drop are the point of
# this unit, the SUID/SGID seccomp would block them (and the exec of
# the session shells would inherit that); model 2 restores yes
RestrictSUIDSGID=no
LockPersonality=yes
MemoryDenyWriteExecute=yes
# QUIC is IPv4 UDP; the forward-agent bridge talks AF_UNIX (the agent
# listener per session), the direct-tcp forwards AF_INET - the
# session shells need nothing beyond the two
RestrictAddressFamilies=AF_INET AF_UNIX
# model 1: exactly what the per-session drop needs - setuid/setgid
# for the identity switch, chown for the pty slave of the
# root-opened session, DAC_READ_SEARCH for the per-user files the
# daemon itself reads (the %u authorized_keys paths); the port is
# bound by the root-owned .socket unit, nothing else is granted
# (model 2 replaces this with an empty bounding set)
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH CAP_SETGID CAP_SETUID

# socket-activated only: enabling the unit is
#   systemctl enable --now ssh3-c-server.socket
# and the service comes up on the first packet
