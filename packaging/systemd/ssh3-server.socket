[Unit]
Description=SSH3 server QUIC/UDP listener (socket activation)
Documentation=man:ssh3-server(8)

[Socket]
# ssh3 is QUIC over UDP (RFC 9000), the route rides HTTP/3 extended
# CONNECT (RFC 9220) - one datagram listener serves everything.
#
# The bare port hands over ONE dual-stack IPv6 socket (BindIPv6Only
# follows the system policy, net.ipv6.bindv6only=0 on the common
# hosts): the daemon serves both families off the single passed fd
# (see ssh3-server(8), SOCKET ACTIVATION) - IPv4 arrives as the
# v4-mapped form, IPv6 natively.  The earlier 0.0.0.0 spelling cut
# the hosts off IPv6 while the daemon had already grown the
# dual-stack acceptance.
ListenDatagram=443
BindIPv6Only=both
#
# Binding as root here is the whole point of the socket activation:
# the bound fd is handed to ssh3-server.service, so the service
# itself needs no CAP_NET_BIND_SERVICE.  Since P7.3 the service runs
# as root with the per-session setuid (see the PRIVILEGE MODELS note
# in ssh3-server.service): the bounding set of the service keeps
# only the identity-switch capabilities, the port privilege stays in
# this unit either way.
#
# Bind even while the address is not yet assigned to the interface
# (anycast/VIP failover setups, late network bring-up).
FreeBind=yes
#
# Port variation: override the line above from a drop-in, do not edit
# this file:
#   systemctl edit ssh3-server.socket
#   [Socket]
#   ListenDatagram=8443

[Install]
WantedBy=sockets.target
