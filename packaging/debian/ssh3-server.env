# /etc/ssh3/ssh3-server.env - environment of the ssh3-server.service
# unit (read through EnvironmentFile).  Uncomment a line to override
# the built-in default; the full flag/env table lives in
# ssh3-server(8) and `ssh3-server --help`.

# Log level: debug | info | warn | error (default: info)
#SSH3_LOG_LEVEL=info

# Log file; empty/unset logs to stderr.  Under systemd the daemon
# logs to the journal regardless (SSH3_LOG_FILE is skipped when
# INVOCATION_ID is set).
#SSH3_LOG_FILE=

# Seconds to drain the active conversations on SIGTERM before the
# close grace (default: 5; the unit budget is TimeoutStopSec=30s)
#SSH3_SHUTDOWN_DRAIN=5

# Password login: on | off (default: on, the sshd
# PasswordAuthentication canon; password auth for the root account is
# always refused).  The system-account verifier follows
# SSH3_PASSWORD_SYSTEM (on by default).
#SSH3_ENABLE_PASSWORD_LOGIN=on
