#!/bin/sh
# postinst for ssh3-server: create the system service user and the state
# directory. there is no conffile yet - the daemon is configured through
# environment variables and command-line flags only.
set -e

case "$1" in
    configure)
        # the unprivileged service account running the daemon
        if ! getent passwd ssh3 >/dev/null; then
            adduser --system --group --home /var/lib/ssh3 --quiet ssh3
        fi
        if [ ! -d /var/lib/ssh3 ]; then
            mkdir -p /var/lib/ssh3
        fi
        chown ssh3:ssh3 /var/lib/ssh3
        chmod 0750 /var/lib/ssh3

        # the systemd units shipped in /usr/lib/systemd/system: the
        # socket carries the UDP listener, the service starts on the
        # first packet (socket activation, no capabilities needed).
        # deb-systemd-helper keeps the admin enable state across
        # upgrades; the reload only runs on a booted systemd
        if [ -x /usr/bin/deb-systemd-helper ]; then
            deb-systemd-helper enable ssh3-c-server.socket >/dev/null || true
            deb-systemd-helper enable ssh3-c-server.service >/dev/null || true
            deb-systemd-helper was-enabled ssh3-c-server.socket >/dev/null 2>&1 || true
        fi
        if [ -d /run/systemd/system ] && [ -x /usr/bin/systemctl ]; then
            systemctl daemon-reload || true
        fi

        printf 'ssh3-server: configured via env/CLI (see ssh3-server -h);\n'
        printf '  SSH3_LOG_LEVEL, SSH3_LOG_FILE, SSH3_SHUTDOWN_DRAIN.\n'
        ;;
esac

exit 0
