#!/sbin/openrc-run

name="ssh3-server"
description="SSH3 server: SSH over the QUIC/HTTP3 transport"

command="/usr/sbin/ssh3-server"
command_args="-3 -l $listen -c $cert -k $key -K $authorized_keys"
command_background="yes"
pidfile="/run/$RC_SVCNAME.pid"
output_log="$log_file"
error_log="$log_file"

depend() {
	need net
	after firewall
}

start_pre() {
	default_start_pre

	if [ ! -s "$cert" ] || [ ! -s "$key" ]; then
		ebegin "generating the self-signed certificate of ssh3-server"
		openssl req -x509 -newkey rsa:2048 -nodes -days 825 \
			-keyout "$key" -out "$cert" \
			-subj "/CN=ssh3-server" >/dev/null 2>&1
		chmod 0640 "$key"
		eend $?
	fi
}
