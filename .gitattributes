# LF everywhere: project is developed on Windows but built/deployed on Linux
* text=auto eol=lf

# Sources are C — never CRLF
*.c text eol=lf
*.h text eol=lf

# Scripts
*.sh text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Docs
*.md text eol=lf

# Windows-only assets keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.der binary
